# ───────── PHYSICA konfiguratsiyasi ─────────
# Bu faylni .env nomi bilan nusxalang va qiymatlarni to'ldiring.
# .env faylini hech qachon git ga qo'shmang.

# development | test | production
NODE_ENV=development
PORT=3000

# Railway kabi proxy ortida ishlaganda 1 qo'ying (rate limit to'g'ri IP ko'rishi uchun)
TRUST_PROXY=0

# Frontend alohida domenda joylashsa, ruxsat berilgan originlar (vergul bilan)
# Masalan: https://physica.example.com
CORS_ORIGINS=

# ── Sessiya ──
# Kamida 32 belgili tasodifiy satr: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_TTL_SECONDS=43200

# ── Telegram ──
# @BotFather bergan token. initData imzosini tekshirish va bot uchun kerak.
TELEGRAM_BOT_TOKEN=
# initData necha soniya yaroqli (standart: 24 soat)
TELEGRAM_INITDATA_MAX_AGE=86400
# Admin Telegram ID lari (vergul bilan). Faqat shu ID lar admin huquqiga ega.
ADMIN_TELEGRAM_IDS=
# Mini App ning ochiq HTTPS manzili (bot tugmasi uchun)
MINI_APP_URL=
# Botni server bilan birga ishga tushirish (long polling): true | false
BOT_ENABLED=false

# ── Ma'lumotlar bazasi ──
# firestore — production uchun (majburiy)
# local     — faqat ishlab chiqish: .data/db.json faylida saqlanadi
# memory    — faqat testlar uchun
DB_DRIVER=local
LOCAL_DB_FILE=.data/db.json

# ── Firebase (DB_DRIVER=firestore bo'lganda) ──
# Service account JSON ni to'liq satr yoki base64 ko'rinishida bering,
# yoki GOOGLE_APPLICATION_CREDENTIALS orqali fayl yo'lini ko'rsating.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# ── Ishlab chiqish uchun brauzer orqali kirish ──
# true bo'lsa Telegram dan tashqarida sinov foydalanuvchisi bilan kirish mumkin.
# NODE_ENV=production da majburan o'chiriladi.
DEV_AUTH_ENABLED=true

# ── Rate limit ──
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=20

# ── AI (PHASE 3 da ishlatiladi; kalit faqat serverda saqlanadi) ──
AI_API_KEY=
AI_MODEL=

LOG_LEVEL=info
